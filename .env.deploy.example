# Copy to .env.deploy (gitignored) and fill in. Used by scripts/deploy.sh.
#
# ssh target for the server
DEPLOY_HOST=shao@your-server
# document root the web server points at
DEPLOY_PATH=/srv/shaostassen.com
# ssh port
DEPLOY_PORT=22
# Where the post-deploy checks should look. Point this at a temporary
# hostname while cutting over, before DNS moves.
# DEPLOY_VERIFY_URL=https://shaostassen.com
